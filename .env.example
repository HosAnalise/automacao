# ==========================================
# CONFIGURAÇÃO DE BROWSERS PARA OS TESTES
# Define quais navegadores serão utilizados na automação
# ==========================================
BROWSER_CHROME=true
BROWSER_FIREFOX=true
BROWSER_EDGE=true

# ==========================================
# CREDENCIAIS DE LOGIN PARA OS TESTES
# Definem os e-mails e senhas dos usuários testados no sistema
# ==========================================
# E-mail e senha para testes gerais
TESTE_EMAIL=usuario_teste@exemplo.com.br
TESTE_PASSWORD=sua_senha_de_teste

# E-mail e senha do usuário Administrador
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_PASSWORD=sua_senha_de_admin

# E-mail e senha de um usuário específico (ex: desenvolvedor)
GABRIEL_EMAIL=desenvolvedor@exemplo.com.br
GABRIEL_PASSWORD=sua_senha_de_desenvolvedor

# Usuário e senha para o Ponto de Venda (PDV)
PDV_EMAIL=usuario_pdv
PDV_PASSWORD=senha_pdv

# Usuário para o Frente de Caixa (FC)
FC_USER="USUARIO_FRENTE_CAIXA"

# ==========================================
# CONFIGURAÇÃO DOS BOTÕES DE LOGIN (Seletores CSS/ID)
# Define quais elementos serão utilizados durante o login
# ==========================================
EMAIL_FIELD="#P9999_USERNAME"
PASSWORD_FIELD="#P9999_PASSWORD"
BTN_LOGIN="#buttonLogin"

# ==========================================
# CONFIGURAÇÃO DOS AMBIENTES DE TESTE
# Define os parâmetros para acessar diferentes ambientes.
# Estes valores geralmente não são sensíveis e podem ser mantidos.
# ==========================================
HOMOLOGACAO_GRUPO_VALORES_AMBIENTE={"nivelAcesso":"5","ambiente":"1","rede":"1261","loja":""}
HOMOLOGACAO_FL3_VALORES_AMBIENTE={"nivelAcesso":"6","ambiente":"1","rede":"1261","loja":"4105"}
NONE_VALORES_AMBIENTE={"nivelAcesso":"1","ambiente":"1","rede":"1","loja":"1"}

# ==========================================
# CONFIGURAÇÕES DE URLs E CAMINHOS DE ARQUIVOS
# Define URLs do sistema e caminhos para armazenamento de arquivos
# ==========================================
URL_ERP=https://url_do_seu_ambiente_de_teste.com.br
SCREENSHOT_PATH=/caminho/para/sua/pasta/de/screenshots
PATH_HOS_FRENTE_CAIXA=C:\Caminho\Para\O\Executavel\HOSFrenteDeCaixa.exe

# ==========================================
# CONFIGURAÇÃO DO MONGODB
# Conexão com o banco de dados MongoDB para armazenamento de logs
# ==========================================
MONGODB_URI="mongodb+srv://<seu_usuario>:<sua_senha>@cluster.mongodb.net/"
DB_NAME=NomeDoSeuBanco
COLLECTION_NAME=NomeDaSuaColecao

# ==========================================
# CONFIGURAÇÃO DO BANCO DE DADOS ORACLE
# Credenciais para conexão com o banco de dados Oracle
# ==========================================
ORACLE_USER=seu_usuario_oracle
ORACLE_PASSWORD=sua_senha_oracle
ORACLE_HOST=host.do.banco.oracle.com.br
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=nome_do_servico_oracle

# Configuração de retenção de logs
DAYS_TO_DELETE_LOGS=7

# ==========================================
# DEFINIÇÃO DO TIPO DE APLICAÇÃO
# Especifica se a automação será executada para Web ou Desktop
# ==========================================
APPLICATION_TYPE=WEB
MODE=local
DEV="Seu Nome"

# ==========================================
# CONFIGURAÇÃO DO APPLITOOLS (Ferramenta de Teste Visual)
# ==========================================
USE_APPLITOOLS=False
APPLITOOLS_API_KEY="SUA_CHAVE_DE_API_DO_APPLITOOLS"
APPLITOOLS_MATCH_LEVEL=LAYOUT

# ==========================================
# CONFIGURAÇÃO DE APIs EXTERNAS
# ==========================================
GOOGLE_API_KEY="SUA_CHAVE_DE_API_DO_GOOGLE"